{
  "name": "@doz6x9/web-based-2d-game-engine-framework",
  "version": "0.2.0",
  "description": "A modular TypeScript 2D grid game engine framework for the web, powered by PixiJS.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && npm run typecheck && npm run build:lib && npm run build:types",
    "build:lib": "vite build --config vite.lib.config.ts",
    "build:types": "tsc -p tsconfig.lib.json",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "2d",
    "game-engine",
    "pixi",
    "pixijs",
    "typescript",
    "tilemap",
    "pathfinding",
    "fov",
    "fog-of-war",
    "a-star",
    "flood-fill",
    "lighting",
    "roguelike",
    "grid"
  ],
  "author": "doz",
  "license": "MIT",
  "peerDependencies": {
    "pixi.js": "^8.18.1"
  },
  "devDependencies": {
    "pixi.js": "^8.18.1",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vitest": "^5.1.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doz6x9/web-based-2d-game-engine-framework.git",
    "directory": "packages/engine"
  },
  "homepage": "https://github.com/doz6x9/web-based-2d-game-engine-framework/tree/engineFramework#readme",
  "bugs": {
    "url": "https://github.com/doz6x9/web-based-2d-game-engine-framework/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
